{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "randykleckner-portfolio",
  "compatibility_date": "2026-10-16",
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "r2_buckets": [
    {
      "binding": "job-mail-inbound",
      "bucket_name": "randy-job-mail"
    }
  ],
  "main": "worker/index.mjs",
  "routes": [
    {
      "pattern": "randykleckner.com",
      "custom_domain": true
    }
  ]
}
